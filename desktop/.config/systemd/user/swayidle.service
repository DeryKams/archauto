[Unit]
Description=Idle and screen lock for Niri
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/swayidle -w timeout 600 '%h/.local/bin/arch-waylock -fork-on-lock' before-sleep '%h/.local/bin/arch-waylock -fork-on-lock'
Restart=on-failure
